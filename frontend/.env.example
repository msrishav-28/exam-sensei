# ExamSensei frontend (TanStack Start / Vite). Copy to .env and fill in.
# Only VITE_-prefixed vars are exposed to the browser.

# FastAPI backend base URL (include the /api/v1 suffix).
# Local dev: http://localhost:8000/api/v1
# Production (Render): https://examsensei-api.onrender.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Supabase project (Dashboard -> Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
