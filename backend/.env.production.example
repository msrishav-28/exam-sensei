# =============================================================================
# ExamSensei Backend - Production Environment Variables
# =============================================================================
# Copy to .env and configure for your environment
# For Render deployment, set these in the Render dashboard

# =============================================================================
# DATABASE - REQUIRED
# =============================================================================

# PostgreSQL connection string
# Render provides this automatically via DATABASE_URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://examsensei:password@localhost:5432/examsensei

# =============================================================================
# SECURITY - REQUIRED (Change in production!)
# =============================================================================

# JWT secret key - MUST be changed in production
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production-use-openssl-rand-hex-32

# JWT algorithm
ALGORITHM=HS256

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CORS - REQUIRED for production
# =============================================================================

# Comma-separated list of allowed origins
# Add your Vercel frontend URL here
ALLOWED_ORIGINS=http://localhost:3000,https://examsensei.vercel.app,https://your-custom-domain.com

# =============================================================================
# REDIS - REQUIRED for caching & rate limiting
# =============================================================================

# Redis connection URL
# Render provides this via REDIS_URL when using Redis addon
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# OLLAMA (AI) - OPTIONAL
# =============================================================================

# Local LLM configuration
# Note: Ollama requires a GPU server, disable on Render free tier
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT=30

# =============================================================================
# EMAIL - OPTIONAL
# =============================================================================

# SMTP configuration for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@examsensei.com

# =============================================================================
# SCRAPING - OPTIONAL
# =============================================================================

SCRAPER_USER_AGENT=ExamSensei-Bot/1.0 (+https://examsensei.com/bot)
SCRAPER_DELAY=2
SCRAPER_MAX_RETRIES=3

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

LOG_LEVEL=INFO
LOG_FILE=logs/examsensei.log

# Environment: development, staging, production
ENVIRONMENT=production

# API versioning
API_VERSION=v1
API_PREFIX=/api/v1

# Sentry DSN for error tracking (optional)
SENTRY_DSN=
