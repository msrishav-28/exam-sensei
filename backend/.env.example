# ============================================================================
# ExamSensei backend — environment variables
# Copy to backend/.env and fill in the values.
# ============================================================================

# ---- Database ----
# Local dev: SQLite file. Production: Supabase Postgres connection string
# (transaction-mode pooler URL on port 6543 is recommended for small apps).
DATABASE_URL=sqlite:///./examsensei.db
# DATABASE_URL=postgresql://postgres:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ---- Supabase Auth (required in production) ----
# Find these in: Supabase Dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_JWT_SECRET=dev-supabase-jwt-secret-change-in-production
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # only set if you call Supabase admin APIs from the backend

# ---- LLM provider keys (optional) ----
# The backend picks the first key in this priority order:
#   anthropic > openai > groq > gemini > null (canned fallback)
# Set LLM_PROVIDER to pin a specific one (auto | gemini | groq | openai | anthropic | none).
LLM_PROVIDER=auto
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- CORS ----
# Comma-separated list of allowed origins (frontend hosts).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Rate limiting ----
CHAT_RATE_LIMIT=30/minute

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Environment ----
# Options: development, staging, production
ENVIRONMENT=development

# ---- Monitoring (optional) ----
SENTRY_DSN=

# ---- Email (optional; not currently used by any wired endpoint) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@examsensei.com
